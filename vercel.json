{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/(dashboard)/intelligence/deep-discovery/[product_id]/page.tsx": {
      "maxDuration": 800
    },
    "app/(dashboard)/products/[id]/edit/page.tsx": {
      "maxDuration": 800
    }
  },
  "crons": [
    {
      "path": "/api/cron/hygiene-scan",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/matching-refresh",
      "schedule": "0 0 * * 0"
    },
    {
      "path": "/api/cron/bzp-monitor",
      "schedule": "0 3 * * *"
    }
  ]
}
